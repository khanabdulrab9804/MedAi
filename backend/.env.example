# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/medai

# Google Gemini API (get key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Use gemini-embedding-001 (text-embedding-004 if available on your API key)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ChromaDB (run: python3 -m uvicorn chromadb.app:app --host localhost --port 8000)
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=medai_knowledge_base
RAG_TOP_K=5
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# Admin panel (change in production)
ADMIN_SECRET=change_this_admin_secret

# JWT auth (doctor / patient login)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS - frontend URL
CLIENT_URL=http://localhost:5173

# Rate limiting (active only in production; set RATE_LIMIT_ENABLED=false to force off)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
